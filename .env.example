# Falhen Media Environment Configuration Example
# Duplicate this file to .env on your server and update values for cPanel deployment.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_falhendb
DB_USER=cpaneluser_dbuser
DB_PASS=YourSecureDatabasePassword123!

APP_ENV=production
APP_URL=https://yourdomain.com
