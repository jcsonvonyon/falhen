# Falhen Media - cPanel .htaccess Configuration
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS (optional based on cPanel SSL setup)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 0. Block direct IP access (Force all traffic through Cloudflare proxied domains)
    RewriteCond %{HTTP_HOST} ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(?::[0-9]+)?$
    RewriteRule ^ https://www.falhen.com%{REQUEST_URI} [R=301,L]

    # Block public web access to sensitive markdown/config files that could expose infrastructure details
    RewriteRule ^(?:SSH_CONFIG|CPANEL_MIGRATION_GUIDE)\.md$ - [F,L,NC]

    # 1. Redirect /index.php to root /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.php[\s?] [NC]
    RewriteRule ^(.*)index\.php$ /$1 [R=301,L]

    # 2. 301 Redirect direct browser requests for .php files to clean URLs (exclude /api/, /admin/, /vendor/, and POST requests)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+?)\.php[\s?] [NC]
    RewriteCond %{REQUEST_URI} !^/api/ [NC]
    RewriteCond %{REQUEST_URI} !^/admin/ [NC]
    RewriteCond %{REQUEST_URI} !^/vendor/ [NC]
    RewriteRule ^ %1 [R=301,L]

    # 3. Host-based routing for client.falhen.com subdomain & custom route aliases
    RewriteCond %{HTTP_HOST} ^client\.falhen\.com(?::\d+)?$ [NC]
    RewriteRule ^(?:album|gallery)/([^/]+)/?$ client-portal.php?slug=$1 [QSA,L]

    RewriteCond %{HTTP_HOST} ^client\.falhen\.com(?::\d+)?$ [NC]
    RewriteRule ^clients/([^/]+)/([^/]+)/?$ client-portal.php?category=$1&slug=$2 [QSA,L]

    RewriteCond %{HTTP_HOST} ^client\.falhen\.com(?::\d+)?$ [NC]
    RewriteRule ^(?:clients|gallery)/?$ client-portal.php?view=clients [QSA,L]

    RewriteCond %{HTTP_HOST} ^client\.falhen\.com(?::\d+)?$ [NC]
    RewriteRule ^$ client-portal.php?view=clients [QSA,L]

    RewriteRule ^clients/([^/]+)/([^/]+)/?$ client-portal.php?category=$1&slug=$2 [QSA,L]
    RewriteRule ^clients/?$ client-portal.php?view=clients [QSA,L]
    RewriteRule ^album/([^/]+)/?$ client-portal.php?slug=$1 [QSA,L]
    RewriteRule ^client-portal/?$ client-portal.php [QSA,L]
    RewriteRule ^dashboard/?$ admin/login.php [QSA,L]
    RewriteRule ^admin/login/?$ admin/login.php [QSA,L]
    RewriteRule ^admin/?$ admin/index.php [QSA,L]
    RewriteRule ^services/([^/]+)/?$ service-single.php?slug=$1 [QSA,L]

    # 4. Serve existing physical files and directories directly (images, css, js, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 5. Internally rewrite extensionless URLs to corresponding .php files (multi-level supported)
    RewriteCond %{DOCUMENT_ROOT}/$1.php -f [OR]
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

# Security Headers & Cloudflare Origin Protection Settings
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# Block public access to sensitive config, environment, and INI files
<FilesMatch "^(\.user\.ini|php\.ini|\.env.*|\.git.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Recommended PHP Directives (LiteSpeed / Apache ea-php)
<IfModule lsapi_module>
    php_value memory_limit 512M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value upload_max_filesize 128M
    php_value post_max_size 128M
    php_value max_input_vars 5000
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

<IfModule mod_php.c>
    php_value memory_limit 512M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value upload_max_filesize 128M
    php_value post_max_size 128M
    php_value max_input_vars 5000
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
