# Protect sensitive configuration files and archives from direct HTTP access
<FilesMatch "\.(json|sql|env|ini|log|sock|zip|csv|tar|gz|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

